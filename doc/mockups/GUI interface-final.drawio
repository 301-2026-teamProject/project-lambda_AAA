  <diagram name="01 Entrant storyboard" id="story-entrant">
    <mxGraphModel dx="2573" dy="1566" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1040" math="0" shadow="0">
