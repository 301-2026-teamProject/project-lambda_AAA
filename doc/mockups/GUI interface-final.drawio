  <diagram name="06 State coverage and submission checklist" id="story-state-checklist">
    <mxGraphModel dx="2633" dy="1602" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#202823;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;Cross-screen states, validation, and hand-in checklist&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#5e6a62;&quot;&gt;These notes make the storyboard reviewable as a product flow and ready for the Part 2 wiki submission.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="2560" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="state_1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Core UI states&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Show &lt;b&gt;loading, empty, success, and recoverable error&lt;/b&gt; states on search results, trips, owner lists, moderation lists, and logs. Preserve entered filters or form data when retrying.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;Applies across Pages 01–03&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="state_2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Lottery status states&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Distinguish upcoming, open, full, joined, closed, winner, not selected, declined, and reserved. Each state must explain why its primary action is available or disabled.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.01.06, 01.02.01–02, 01.03.01–02, 02.04.01–07&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="690" y="130" as="geometry" />
        </mxCell>
        <mxCell id="state_3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Input validation&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Validate location/date/guest filters; positive occupancy, price, capacity, and winner count; registration before booking dates; required destructive-action reasons; and required rules acknowledgement.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.01.02, 02.01.02, 02.04.03–07, 02.11.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="1340" y="130" as="geometry" />
        </mxCell>
        <mxCell id="state_4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S4&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;System-event transitions&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Use dashed transitions for lottery close/automatic draw and incoming notifications. The destination screen states what changed and provides the next action; it does not imply the entrant triggered the event.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.03.01–02, 02.05.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="1990" y="130" as="geometry" />
        </mxCell>
        <mxCell id="state_5" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S5&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Navigation anchors&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Entrant: Explore · Lotteries · Trips · Profile. Owner: Home · Campsites · Lotteries · Reservations. Admin: Dashboard · Campsites · Profiles · Images · Logs. Role switching returns to the matching home.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;Supports all actor flows&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="state_6" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S6&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Accessibility baseline&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Use visible labels, readable type, sufficient contrast, large touch targets, and text/icons in addition to color for status. This supports the required simple, attractive, easy-to-use application; optional accessibility mode remains out of scope.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;Project goal; not a new user story&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="690" y="590" as="geometry" />
        </mxCell>
        <mxCell id="state_7" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#fff1ef;strokeColor=#d18880;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S7&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Scope boundary&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Do not present bonus features as required: reservation map, match score, radius map, advanced review threads, featured carousel, accessibility mode, or expanded two-way messaging need separate approval/planning.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;Official optional WOW factor&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="1340" y="590" as="geometry" />
        </mxCell>
        <mxCell id="state_8" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;S8&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Part 2 submission check&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;Export every storyboard page at a legible scale; embed the images in the team wiki; keep source and images inside the repository; verify all 60 official IDs; incorporate TA feedback before submission.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;Official Part 2 deliverable and submission rules&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="1990" y="590" as="geometry" />
        </mxCell>
        <mxCell id="source_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#202823;strokeColor=none;fillColor=none;" value="&lt;b&gt;Source check:&lt;/b&gt; official CMPUT 301 Project Part 2 and Project Problem Description, reviewed 2026-10-17. &lt;font color=&quot;#5e6a62&quot;&gt;Requirement IDs are kept inside the diagrams so exported wiki images remain self-contained.&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="2550" x="40" y="1010" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="07 Entrant UI wireframes" id="story-entrant-wireframes">
    <mxGraphModel dx="2409" dy="1466" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ew_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#202823;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;Entrant mobile screens and dialogs&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#5e6a62;&quot;&gt;Visual layouts fill the remaining mockup gaps. Requirement IDs are listed individually; halfway scope follows the updated backlog.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="2360" x="40" y="20" as="geometry" />
