        <mxCell id="dialog_7" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D7&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Share campsite QR&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Owned campsite › QR code&lt;br&gt;&lt;b&gt;CONTENT:&lt;/b&gt; Unique code and destination preview&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Close · Save image · Share&lt;br&gt;&lt;b&gt;RESULT:&lt;/b&gt; Entrant scan opens campsite details.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 02.02.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
