        <mxCell id="dialog_8" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D8&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Notify waitlist&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Lottery waitlist › Notify entrants&lt;br&gt;&lt;b&gt;FIELDS:&lt;/b&gt; Audience · Subject · Message&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Cancel · Send notification&lt;br&gt;&lt;b&gt;STATES:&lt;/b&gt; Required-field errors · Sending · Sent.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 02.10.01–02&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="600" x="1990" y="490" as="geometry" />
        </mxCell>
        <mxCell id="dialog_9" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#fff1ef;strokeColor=#d18880;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D9&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Reject reservation&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Reservation details › Reject&lt;br&gt;&lt;b&gt;FIELD:&lt;/b&gt; Required reason&lt;br&gt;&lt;b&gt;MESSAGE:&lt;/b&gt; Show policy/refund impact before confirmation.&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Keep reservation · Reject reservation.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 02.08.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="600" x="40" y="850" as="geometry" />
        </mxCell>
        <mxCell id="dialog_10" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D10&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Message entrant&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Reservation details › Message&lt;br&gt;&lt;b&gt;CONTEXT:&lt;/b&gt; Entrant, campsite, and stay dates&lt;br&gt;&lt;b&gt;INPUT:&lt;/b&gt; Required message text&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Cancel · Send message&lt;br&gt;&lt;b&gt;STATES:&lt;/b&gt; Sending · Sent · Retry.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 02.12.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="600" x="690" y="850" as="geometry" />
        </mxCell>
        <mxCell id="dialog_11" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#fff1ef;strokeColor=#d18880;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D11&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Remove campsite&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Campsite review › Remove&lt;br&gt;&lt;b&gt;CONTEXT:&lt;/b&gt; Listing and affected reservations/lotteries&lt;br&gt;&lt;b&gt;FIELD:&lt;/b&gt; Moderation reason&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Cancel · Remove campsite&lt;br&gt;&lt;b&gt;RESULT:&lt;/b&gt; Audit entry and list refresh.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 03.01.01, 03.04.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="600" x="1340" y="850" as="geometry" />
        </mxCell>
        <mxCell id="dialog_12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#fff1ef;strokeColor=#d18880;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D12&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Remove profile / owner&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Profile review › Remove&lt;br&gt;&lt;b&gt;CONTEXT:&lt;/b&gt; Role and policy violation&lt;br&gt;&lt;b&gt;FIELD:&lt;/b&gt; Moderation reason&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Cancel · Remove profile/owner&lt;br&gt;&lt;b&gt;RESULT:&lt;/b&gt; Audit entry and list refresh.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 03.02.01, 03.05.01, 03.07.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="600" x="1990" y="850" as="geometry" />
        </mxCell>
        <mxCell id="dialog_13" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#fff1ef;strokeColor=#d18880;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D13&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Remove uploaded image&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Image preview › Remove&lt;br&gt;&lt;b&gt;CONTEXT:&lt;/b&gt; Image, uploader, campsite/profile&lt;br&gt;&lt;b&gt;FIELD:&lt;/b&gt; Moderation reason&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Cancel · Remove image&lt;br&gt;&lt;b&gt;RESULT:&lt;/b&gt; Placeholder plus audit entry.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 03.03.01, 03.06.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
