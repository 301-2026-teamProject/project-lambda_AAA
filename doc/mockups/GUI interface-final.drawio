        <mxCell id="dialog_6" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;D6&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Reservation delivery&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;OPEN: Reservation confirmation › Get copy&lt;br&gt;&lt;b&gt;CONTENT:&lt;/b&gt; Campsite, dates, guests, reservation ID&lt;br&gt;&lt;b&gt;BUTTONS:&lt;/b&gt; Download CSV · View notification&lt;br&gt;&lt;b&gt;RESULT:&lt;/b&gt; Download/share success or retry state.&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.05.02, 01.07.02&lt;/b&gt;&lt;/div&gt;" vertex="1">
