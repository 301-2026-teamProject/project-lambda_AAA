        <mxCell id="1" parent="0" />
        <mxCell id="e_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#202823;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;Entrant storyboard and missing UI states&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#5e6a62;&quot;&gt;Editable cards show controls/dialogs. Green IDs are official requirements; arrows name the trigger.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="2540" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="e_start" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#e4f1e7;strokeColor=#77a889;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;E1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Device start&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;• Identify this device&lt;br&gt;• Continue without username/password&lt;br&gt;• Bottom navigation&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.09.01&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="320" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="e_search" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;E2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Search and filters&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;• Search term&lt;br&gt;• Location, dates, guests&lt;br&gt;• Clear filters; loading/empty/error&lt;br&gt;• Summary cards&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.01.01–04&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="320" x="410" y="130" as="geometry" />
        </mxCell>
        <mxCell id="e_details" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;E3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Campsite details&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;• Amenities, occupancy, rating, price&lt;br&gt;• Image and map&lt;br&gt;• Active lottery and status&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.01.05–06&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="320" x="780" y="130" as="geometry" />
        </mxCell>
        <mxCell id="e_wait" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=14;fontSize=15;fontColor=#202823;fillColor=#ffffff;strokeColor=#b8c1ba;strokeWidth=2;shadow=0;" value="&lt;div style=&quot;font-size:13px;color:#5e6a62;&quot;&gt;&lt;b&gt;E4&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;Waiting-list state&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.45;color:#202823;&quot;&gt;• Join / Leave button&lt;br&gt;• Closed, full, joined reasons&lt;br&gt;• Leave confirmation dialog&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;color:#246b45;&quot;&gt;&lt;b&gt;US 01.02.01–02&lt;/b&gt;&lt;/div&gt;" vertex="1">
